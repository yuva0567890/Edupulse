# Copy this file to ".env" and edit. Never commit your real .env file to a public repository.
SECRET_KEY=change-this-secret-key
# Leave empty for local SQLite (instance/edupulse.db). PostgreSQL: postgresql://user:pass@host:5432/dbname
DATABASE_URL=
# true = load ~300 synthetic demo feedback rows if the database is empty
AUTO_SEED=true
FLASK_DEBUG=0
# --- Sign-up policy (admin accounts are created on /admin/signup and stored in the database)
# Unset: open on your own computer; in production only the FIRST account can sign up.
# true / false force it open / closed (the very first account is always allowed).
ALLOW_SIGNUP=
# Optional invitation code required for every account after the first one
ADMIN_SIGNUP_CODE=
